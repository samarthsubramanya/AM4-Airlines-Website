PORT=4000
# MongoDB Atlas connection string. Leave empty to use the in-memory store (data resets on restart).
MONGODB_URI=
MONGODB_DB=indiancom
# Shared with the Catalyst auth_bridge function. Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=
# Comma-separated frontend origins allowed to call the API, e.g. https://indian-com.vercel.app
CORS_ORIGINS=
# Set to false once Catalyst sign-in is live to disable the demo login.
DEMO_AUTH=true
# Password for /admin (defaults to "admin" outside production; admin login is off in production until set).
ADMIN_PASSWORD=
# Zoho Catalyst users with these emails are admins too (comma separated).
ADMIN_EMAILS=
